model assessmentControl {
	id				Int				@id @default(autoincrement()) @db.Integer
	count 			Int				@db.Integer
	maxCount		Int				@db.Integer
	context			String			@db.VarChar(255)
	type			controls_type	@default(ORGANIZATION)

	isoAssessmentId	Int				@db.Integer
	isoAssessment	isoAssessment	@relation(fields: [isoAssessmentId], references: [id], onDelete: Cascade)
	controls 	    controls[]

	createdAt		DateTime		@default(now())
	updatedAt		DateTime		@updatedAt
}


enum controls_type {
  PHYSICAL
  PEOPLE
  ORGANIZATION
  TECHNOLOGICAL
}
